# Copy to .env and fill in. The pipeline runs fully without any of these.

# Optional API reasoning arm (OpenAI-compatible endpoint)
API_PROVIDER=deepseek            # deepseek | gemini
DEEPSEEK_API_KEY=your-deepseek-key-here
GEMINI_API_KEY=your-gemini-key-here

# Optional: Hugging Face token (all datasets used are public; only needed for rate limits)
HF_TOKEN=

# Profile selection (home | lab)
SUPPORT_PROFILE=home
